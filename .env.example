# ═══════════════════════════════════════════
# Omni-Vision v2.0 — Environment Variables
# ═══════════════════════════════════════════

# ─── Core ───
SECRET_KEY=change-this-to-random-64-char-string
PORT=8000
ADMIN_USER=admin
ADMIN_PASS=change_me
BOSS_KEY=your_boss_key_here
HUNT_INTERVAL=60

# ─── AI (required for AI Chat) ───
GROQ_API_KEY=gsk_your_key_here
OPENROUTER_API_KEY=sk-or-your_key_here

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
ADMIN_CHAT_ID=your_telegram_user_id
BOT_USERNAME=your_bot_username
TELEGRAM_CHANNEL_ID=-100your_channel_id

# ─── Payments ───
CRYPTOBOT_TOKEN=your_cryptobot_api_token

# ─── Referral Links (passive income) ───
REF_BYBIT=https://www.bybit.com/invite?ref=YOUR_CODE
REF_BINGX=https://bingx.com/invite/YOUR_CODE
REF_OKX=https://www.okx.com/join/YOUR_CODE
REF_BINANCE=https://accounts.binance.com/register?ref=YOUR_CODE
DEFAULT_EXCHANGE=bybit

# ─── Site ───
SITE_URL=https://your-domain.com
